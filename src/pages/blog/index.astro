---
import Base from "../../layouts/Base.astro";
import { posts } from "../../data/posts";
---
<Base title="Water heater guides | Copperlane Vero Beach" description="Short guides on leaking tanks, shutoff steps, and gas versus electric heaters in Vero Beach." path="/blog/">
  <section class="py-16 bg-ink text-white">
    <div class="max-w-7xl mx-auto px-4">
      <p class="hero-kicker">Guides</p>
      <h1 class="hero-title">Water heater notes for Vero Beach</h1>
      <p class="mt-4 text-white/75 max-w-2xl">Plain steps. No price list. If water is spreading, call before you finish an article.</p>
    </div>
  </section>
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-6">
      {posts.map((post) => (
        <a href={`/blog/${post.slug}/`} class="bg-white border border-stone-200 rounded-2xl overflow-hidden card-hover">
          <img src={post.image} alt={post.imageAlt} class="h-48 w-full object-cover" />
          <span class="block p-5">
            <span class="text-sm text-gray-500">{post.date}</span>
            <span class="block font-heading text-xl font-bold mt-1">{post.title}</span>
          </span>
        </a>
      ))}
    </div>
  </section>
</Base>
