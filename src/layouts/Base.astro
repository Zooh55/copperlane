---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";

interface Props {
  title: string;
  description: string;
  path: string;
  type?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  extraSchema?: any[];
}

const {
  title,
  description,
  path,
  type = "website",
  publishedTime,
  modifiedTime = "2026-03-15T08:00:00-04:00",
  extraSchema = [],
} = Astro.props;

const canonical = new URL(path, site.domain).href;

// Build Breadcrumbs
const pathSegments = path.split("/").filter(Boolean);
const breadcrumbItems = [
  {
    "@type": "ListItem",
    position: 1,
    name: "Home",
    item: site.domain + "/",
  },
];

if (pathSegments.length > 0) {
  let accumPath = "";
  pathSegments.forEach((segment, index) => {
    accumPath += `/${segment}`;
    const name = segment
      .replace(/-/g, " ")
      .replace(/\b\w/g, (c) => c.toUpperCase());
    breadcrumbItems.push({
      "@type": "ListItem",
      position: index + 2,
      name,
      item: new URL(accumPath + "/", site.domain).href,
    });
  });
}

const businessId = `${site.domain}/#business`;
const websiteId = `${site.domain}/#website`;

const schemaGraph: any[] = [
  {
    "@type": "PlumbingContractor",
    "@id": businessId,
    name: site.name,
    legalName: site.legalName,
    alternateName: ["Copperlane Vero Beach", "Copperlane Water Heaters"],
    url: site.domain,
    telephone: "+1-772-555-0140",
    priceRange: site.priceRange,
    currenciesAccepted: "USD",
    paymentAccepted: "Cash, Credit Card, Check",
    address: {
      "@type": "PostalAddress",
      streetAddress: site.street,
      addressLocality: site.city,
      addressRegion: site.state,
      postalCode: site.zip,
      addressCountry: "US",
    },
    geo: {
      "@type": "GeoCoordinates",
      latitude: site.geo.lat,
      longitude: site.geo.lng,
    },
    openingHoursSpecification: [
      {
        "@type": "OpeningHoursSpecification",
        dayOfWeek: [
          "Monday",
          "Tuesday",
          "Wednesday",
          "Thursday",
          "Friday",
          "Saturday",
          "Sunday",
        ],
        opens: "00:00",
        closes: "23:59",
      },
    ],
    areaServed: [
      {
        "@type": "AdministrativeArea",
        name: site.county,
      },
      {
        "@type": "City",
        name: "Vero Beach",
      },
      {
        "@type": "City",
        name: "Florida Ridge",
      },
      {
        "@type": "City",
        name: "West Vero Corridor",
      },
      {
        "@type": "City",
        name: "Gifford",
      },
      {
        "@type": "City",
        name: "Wabasso",
      },
      {
        "@type": "City",
        name: "South Beach",
      },
      ...site.zips.map((zip) => ({
        "@type": "PostalCode",
        postalCode: zip,
        addressCountry: "US",
      })),
    ],
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "Water Heater Emergency & Installation Services",
      itemListElement: [
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "Emergency Leaking Water Heater Repair",
            description: "Rapid dispatch containment and repair for leaking residential water heaters in Vero Beach, FL.",
          },
        },
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "Water Heater Replacement & Installation",
            description: "Code-compliant replacement of failed storage water heaters with high-efficiency 40, 50, and 80-gallon models.",
          },
        },
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "Tankless Water Heater Installation & Descaling",
            description: "Continuous on-demand hot water solutions and descaling maintenance for high-mineral Vero Beach water.",
          },
        },
      ],
    },
    aggregateRating: {
      "@type": "AggregateRating",
      ratingValue: "4.9",
      reviewCount: "148",
      bestRating: "5",
      worstRating: "1",
    },
  },
  {
    "@type": "WebSite",
    "@id": websiteId,
    url: site.domain,
    name: site.name,
    description: "Vero Beach Emergency Water Heater Repair, Replacement, and Tankless Specialists",
    publisher: { "@id": businessId },
  },
  {
    "@type": "WebPage",
    "@id": `${canonical}#webpage`,
    url: canonical,
    name: title,
    description: description,
    isPartOf: { "@id": websiteId },
    about: { "@id": businessId },
    dateModified: modifiedTime,
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${canonical}#breadcrumbs`,
    itemListElement: breadcrumbItems,
  },
  ...extraSchema,
];

const schemaJson = {
  "@context": "https://schema.org",
  "@graph": schemaGraph,
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={`${site.domain}/logo.svg`} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site.domain}/logo.svg`} />

    <!-- Geo Metadata for Local SEO -->
    <meta name="geo.region" content="US-FL" />
    <meta name="geo.placename" content="Vero Beach" />
    <meta name="geo.position" content="27.6386;-80.3973" />
    <meta name="ICBM" content="27.6386, -80.3973" />
    <meta name="theme-color" content="#0a1526" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    
    <!-- Machine-Readable Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaJson)} />
  </head>
  <body class="flex flex-col min-h-screen text-gray-800 bg-white selection:bg-cyan-100 selection:text-cyan-900">
    <Header />
    <main id="main-content" class="flex-grow">
      <slot />
    </main>
    <Footer />

    <!-- Mobile Sticky Call Bar -->
    <div class="mobile-call-bar">
      <div class="flex items-center justify-between w-full gap-3">
        <div class="flex items-center gap-2">
          <span class="pulse-indicator">
            <span class="pulse-dot"></span>
          </span>
          <div class="text-xs text-white">
            <p class="font-bold leading-tight">24/7 Vero Beach Dispatch</p>
            <p class="text-secondary text-[10px]">Avg Response: 45 Mins</p>
          </div>
        </div>
        <a href={site.phoneTel} class="flex items-center justify-center gap-1.5 bg-primary hover:bg-primary-dark text-white font-extrabold text-sm py-2.5 px-4 rounded-full shadow-lg uppercase tracking-wider shrink-0">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
          Call (772) 555-0140
        </a>
      </div>
    </div>
  </body>
</html>
