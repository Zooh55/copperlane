---
import { site, services, areas } from "../data/site";
const path = Astro.url.pathname;
const links = [
  { href: "/", label: "Home" },
  { href: "/services/", label: "Services" },
  { href: "/neighborhoods/", label: "Neighborhoods" },
  { href: "/about/", label: "About" },
  { href: "/blog/", label: "Blog" },
  { href: "/faq/", label: "FAQ" },
  { href: "/contact/", label: "Contact" },
];
---
<header class="sticky top-0 z-50 bg-white shadow-lg">
  <!-- Top Emergency Dispatch Strip -->
  <div class="bg-dark text-white overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 py-2 flex justify-between items-center gap-3 text-sm min-w-0">
      <div class="flex items-center gap-2 min-w-0">
        <span class="emergency-badge shrink-0">Leaking</span>
        <span class="hidden sm:inline truncate">Water heater help in Vero Beach · 24/7 Dispatch</span>
      </div>
      <a href={site.phoneTel} class="font-bold text-secondary hover:text-white flex items-center gap-1.5 shrink-0 whitespace-nowrap">
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
        {site.phone}
      </a>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <nav class="max-w-7xl mx-auto px-4 py-3">
    <div class="flex justify-between items-center gap-3 min-w-0">
      <a href="/" class="flex items-center gap-2.5 min-w-0 flex-1">
        <img src="/logo.svg" alt="Copperlane logo" class="h-10 w-10 sm:h-12 sm:w-12 shrink-0" width="48" height="48" />
        <span class="leading-none min-w-0">
          <span class="block font-heading text-base sm:text-xl font-bold tracking-tight text-ink truncate lg:hidden">{site.shortName}</span>
          <span class="hidden lg:block font-heading text-xl font-bold tracking-tight text-ink">{site.name}</span>
          <span class="block mt-1 text-[0.65rem] font-extrabold tracking-[0.16em] uppercase text-primary">Vero Beach</span>
        </span>
      </a>

      <!-- Desktop Navigation Links -->
      <div class="hidden lg:flex items-center gap-6 shrink-0">
        {links.map((link) => (
          <a
            href={link.href}
            class:list={[
              "text-sm font-semibold transition-colors hover:text-primary",
              path === link.href ? "text-primary font-bold" : "text-gray-700"
            ]}
          >
            {link.label}
          </a>
        ))}
        <a
          href={site.phoneTel}
          class="bg-primary hover:bg-primary-dark text-white font-bold py-3 px-6 rounded-full text-sm shadow-lg transition-colors"
        >
          CALL NOW: {site.phone}
        </a>
      </div>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="menu-btn"
        class="lg:hidden shrink-0 inline-flex items-center justify-center p-2.5 text-gray-700 border border-gray-200 rounded-lg bg-white"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        type="button"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.25" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>

    <!-- Mobile Dropdown Navigation -->
    <div id="mobile-nav" class="hidden lg:hidden pt-3 pb-3 border-t border-gray-100 mt-3">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            "block py-2 font-semibold",
            path === link.href ? "text-primary" : "text-gray-800"
          ]}
        >
          {link.label}
        </a>
      ))}
      <p class="text-xs font-bold uppercase tracking-wide text-gray-400 mt-4 mb-1">Direct Services</p>
      <div class="grid grid-cols-2 gap-1 text-sm">
        {services.map((s) => (
          <a href={s.href} class="block py-1.5 text-gray-700 hover:text-primary">{s.label}</a>
        ))}
      </div>
      <p class="text-xs font-bold uppercase tracking-wide text-gray-400 mt-4 mb-1">Neighborhoods</p>
      <div class="grid grid-cols-2 gap-1 text-sm">
        {areas.map((a) => (
          <a href={a.href} class="block py-1.5 text-gray-700 hover:text-primary">{a.label}</a>
        ))}
      </div>
      <a
        href={site.phoneTel}
        class="mt-4 flex items-center justify-center gap-2 bg-primary text-white font-bold py-3 px-5 rounded-full text-center shadow-md w-full"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
        Call {site.phone}
      </a>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById("menu-btn");
  const nav = document.getElementById("mobile-nav");
  btn?.addEventListener("click", () => {
    const isHidden = nav?.classList.toggle("hidden");
    btn.setAttribute("aria-expanded", isHidden ? "false" : "true");
  });
</script>
