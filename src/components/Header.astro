---
import { site, services, areas } from "../data/site";
const path = Astro.url.pathname;
const links = [
  { href: "/", label: "Home" },
  { href: "/services/", label: "Services" },
  { href: "/florida-ridge/", label: "Neighborhoods" },
  { href: "/about/", label: "About" },
  { href: "/blog/", label: "Blog" },
  { href: "/faq/", label: "FAQ" },
  { href: "/contact/", label: "Contact" },
];
---
<header class="sticky top-0 z-50 bg-white shadow-lg">
  <div class="bg-dark text-white">
    <div class="max-w-7xl mx-auto px-4 py-2 flex justify-between items-center text-sm">
      <div class="flex items-center gap-2">
        <span class="emergency-badge">Leaking</span>
        <span class="hidden sm:inline">Water heater help in Vero Beach</span>
      </div>
      <a href={site.phoneTel} class="font-bold text-secondary hover:text-white">{site.phone}</a>
    </div>
  </div>
  <nav class="max-w-7xl mx-auto px-4 py-3">
    <div class="flex justify-between items-center gap-4">
      <a href="/" class="flex items-center gap-3 shrink-0">
        <img src="/logo.svg" alt="" class="h-12 w-12" width="48" height="48" />
        <span class="leading-none">
          <span class="block font-heading text-xl font-bold tracking-tight text-ink">{site.name}</span>
          <span class="block mt-1 text-[0.65rem] font-extrabold tracking-[0.16em] uppercase text-primary">Vero Beach</span>
        </span>
      </a>
      <div class="hidden lg:flex items-center gap-6">
        {links.map((link) => (
          <a href={link.href} class:list={["text-sm font-semibold hover:text-primary", path === link.href ? "text-primary" : "text-gray-700"]}>{link.label}</a>
        ))}
        <a href={site.phoneTel} class="bg-primary hover:bg-primary-dark text-white font-bold py-3 px-6 rounded-full text-sm shadow-lg">CALL NOW: {site.phone}</a>
      </div>
      <button id="menu-btn" class="lg:hidden p-2 text-gray-700" aria-expanded="false" aria-controls="mobile-nav" type="button">Menu</button>
    </div>
    <div id="mobile-nav" class="hidden lg:hidden pt-3 pb-2 border-t border-gray-100 mt-3">
      {links.map((link) => (
        <a href={link.href} class="block py-2 font-semibold text-gray-800">{link.label}</a>
      ))}
      <p class="text-xs font-bold uppercase tracking-wide text-gray-400 mt-3">Services</p>
      {services.map((s) => <a href={s.href} class="block py-1.5 text-sm text-gray-700">{s.label}</a>)}
      <p class="text-xs font-bold uppercase tracking-wide text-gray-400 mt-3">Neighborhoods</p>
      {areas.map((a) => <a href={a.href} class="block py-1.5 text-sm text-gray-700">{a.label}</a>)}
      <a href={site.phoneTel} class="mt-3 inline-flex bg-primary text-white font-bold py-3 px-5 rounded-full">Call {site.phone}</a>
    </div>
  </nav>
</header>
<script>
  const btn = document.getElementById("menu-btn");
  const nav = document.getElementById("mobile-nav");
  btn?.addEventListener("click", () => {
    const open = nav?.classList.toggle("hidden") === false;
    btn.setAttribute("aria-expanded", open ? "true" : "false");
  });
</script>
