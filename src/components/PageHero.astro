---
import { site } from "../data/site";
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
}
const { eyebrow = "Vero Beach, Florida", title, description, image = "/images/hero.jpg", imageAlt = "Leaking water heater in a Vero Beach garage" } = Astro.props;
---
<section class="page-hero">
  <img src={image} alt={imageAlt} class="page-hero-photo" />
  <div class="page-hero-shade" aria-hidden="true"></div>
  <div class="relative max-w-7xl mx-auto px-4 py-14 md:py-20">
    <div class="max-w-xl">
      <p class="hero-kicker">{eyebrow}</p>
      <h1 class="hero-title text-white">{title}</h1>
      <p class="mt-4 text-base md:text-lg text-white/80 leading-relaxed">{description}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={site.phoneTel} class="hero-call">Call {site.phone}</a>
        <a href="/contact/" class="hero-estimate">Free estimate</a>
      </div>
    </div>
  </div>
  <div class="urgency-stripe h-1.5 relative"></div>
</section>
