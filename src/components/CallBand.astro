---
import { site } from "../data/site";
interface Props {
  title: string;
  text?: string;
  urgent?: boolean;
}
const {
  title,
  text = "Have the street, the ZIP, and whether the tank is gas or electric.",
  urgent = false,
} = Astro.props;
---
<section class="bg-primary text-white">
  <div class="max-w-7xl mx-auto px-4 py-12 md:py-14 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
    <div class="max-w-xl">
      <div class="flex items-center gap-2 mb-2">
        <span class="pulse-indicator">
          <span class="pulse-dot"></span>
        </span>
        <p class="text-secondary text-xs font-extrabold tracking-[0.16em] uppercase">
          {urgent ? "Emergency Dispatch Ready" : "Need help now?"}
        </p>
      </div>
      <h2 class="font-heading text-3xl md:text-4xl font-black leading-tight text-white">{title}</h2>
      <p class="mt-2 text-white/85 text-base md:text-lg">{text}</p>
    </div>
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 shrink-0">
      <a
        href={site.phoneTel}
        class="bg-dark hover:bg-black text-white font-extrabold text-lg py-3.5 px-6 rounded-lg shadow-lg flex items-center justify-center gap-2 transition-colors"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
        Call {site.phone}
      </a>
      <a
        href="/contact/"
        class="border border-white/60 hover:border-white text-white font-bold py-3.5 px-5 rounded-lg text-center transition-colors text-base"
      >
        Request Callback
      </a>
    </div>
  </div>
</section>
