---
import { site, services, areas } from "../data/site";
const year = new Date().getFullYear();
---
<footer class="bg-[#0c0a09] text-white pb-24">
  <div class="max-w-7xl mx-auto px-4 py-14 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-8">
    <div class="sm:col-span-2 lg:col-span-4">
      <a href="/" class="inline-flex items-center gap-3 mb-4">
        <img src="/logo.svg" alt="" class="h-12 w-12" width="48" height="48" />
        <span>
          <span class="block font-heading text-xl font-bold leading-none">Copperlane</span>
          <span class="block mt-1 text-[0.65rem] font-extrabold tracking-[0.16em] uppercase text-secondary">Vero Beach</span>
        </span>
      </a>
      <p class="text-gray-400 leading-relaxed max-w-sm">Leaking water heaters in Vero Beach. We find the leak, and you approve the price before we start.</p>
    </div>
    <div class="lg:col-span-2">
      <h2 class="text-sm font-extrabold tracking-wide uppercase text-secondary mb-4">Services</h2>
      <ul class="space-y-2.5">
        {services.map((s) => (
          <li><a href={s.href} class="text-gray-300 hover:text-white">{s.label}</a></li>
        ))}
      </ul>
    </div>
    <div class="lg:col-span-2">
      <h2 class="text-sm font-extrabold tracking-wide uppercase text-secondary mb-4">Visit</h2>
      <ul class="space-y-2.5">
        <li><a href="/about/" class="text-gray-300 hover:text-white">About</a></li>
        <li><a href="/blog/" class="text-gray-300 hover:text-white">Blog</a></li>
        <li><a href="/faq/" class="text-gray-300 hover:text-white">FAQ</a></li>
        <li><a href="/contact/" class="text-gray-300 hover:text-white">Contact</a></li>
        <li><a href="/privacy/" class="text-gray-300 hover:text-white">Privacy</a></li>
      </ul>
      <h2 class="text-sm font-extrabold tracking-wide uppercase text-secondary mb-3 mt-6">Areas</h2>
      <ul class="space-y-2">
        {areas.map((a) => (
          <li><a href={a.href} class="text-gray-300 hover:text-white text-sm">{a.label}</a></li>
        ))}
      </ul>
    </div>
    <div class="sm:col-span-2 lg:col-span-4">
      <h2 class="text-sm font-extrabold tracking-wide uppercase text-secondary mb-4">Map</h2>
      <p class="text-white font-semibold mb-1">{site.street}</p>
      <p class="text-gray-400 mb-3">{site.city}</p>
      <a href={site.phoneTel} class="text-secondary font-extrabold text-lg hover:text-white">{site.phone}</a>
      <p class="text-gray-500 text-sm mt-1 mb-4">{site.zips.join(" · ")}</p>
      <div class="rounded-xl overflow-hidden h-52 ring-1 ring-white/10">
        <iframe title="Map of 4038 43rd Ave, Vero Beach" class="w-full h-full border-0" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://maps.google.com/maps?q=4038%2043rd%20Ave%2C%20Vero%20Beach%2C%20FL%2032960&z=15&output=embed"></iframe>
      </div>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 py-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 text-sm text-gray-500">
      <p>&copy; {year} Copperlane</p>
      <p>Vero Beach, Florida</p>
    </div>
  </div>
</footer>
<a href={site.phoneTel} class="fixed bottom-4 right-4 z-50 bg-primary text-white font-extrabold py-3.5 px-5 rounded-full shadow-2xl">Leaking? Call now</a>
