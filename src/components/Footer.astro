---
import { site, services, areas } from "../data/site";
const year = new Date().getFullYear();
---
<footer class="bg-dark text-white border-t border-slate-800 pb-24 lg:pb-12">
  <!-- Top Indian River County Dispatch Strip -->
  <div class="bg-dark border-b border-white/10 py-5">
    <div class="max-w-7xl mx-auto px-4 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-300 min-w-0">
      <div class="flex flex-wrap items-center justify-center md:justify-start gap-x-2.5 gap-y-1 min-w-0">
        <span class="pulse-indicator shrink-0">
          <span class="pulse-dot"></span>
        </span>
        <span class="font-bold text-white uppercase tracking-wider text-center md:text-left">Indian River County Water Heater Dispatch</span>
        <span class="hidden sm:inline text-slate-500">|</span>
        <span class="text-secondary font-semibold text-center md:text-left">ZIPs: {site.zips.join(" · ")}</span>
      </div>
      <div class="text-slate-400">
        Florida Building Code & Indian River County Permitted Installations
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 py-14 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-8">
    <!-- Company Info & Direct Call -->
    <div class="sm:col-span-2 lg:col-span-4">
      <a href="/" class="inline-flex items-center gap-3 mb-4">
        <img src="/logo.svg" alt="Copperlane logo" class="h-12 w-12" width="48" height="48" />
        <span>
          <span class="block font-heading text-xl font-bold leading-none text-white">Copperlane</span>
          <span class="block mt-1 text-[0.65rem] font-extrabold tracking-[0.16em] uppercase text-secondary">Vero Beach</span>
        </span>
      </a>
      <p class="text-gray-400 leading-relaxed text-sm mb-6 max-w-sm">
        Specialized water heater leak diagnostics, emergency burst containment, parts repair, and complete tankless & storage replacements across Vero Beach and Indian River County.
      </p>

      <div class="bg-black/40 p-4 rounded-xl border border-white/10 space-y-1.5 text-sm">
        <p class="text-xs uppercase font-extrabold tracking-wider text-gray-400">24/7 Emergency Line</p>
        <a href={site.phoneTel} class="text-xl font-black text-secondary hover:text-white transition-colors block">
          {site.phone}
        </a>
        <p class="text-xs text-gray-400">You approve the price before any work begins.</p>
      </div>
    </div>

    <!-- Services -->
    <div class="lg:col-span-3">
      <h2 class="text-sm font-extrabold tracking-wide uppercase text-secondary mb-4">Services</h2>
      <ul class="space-y-2.5 text-sm">
        {services.map((s) => (
          <li>
            <a href={s.href} class="text-gray-300 hover:text-white transition-colors">
              {s.label}
            </a>
          </li>
        ))}
        <li>
          <a href="/services/" class="text-secondary font-bold hover:underline inline-block mt-1">
            All Services →
          </a>
        </li>
      </ul>
    </div>

    <!-- Areas & Resources -->
    <div class="lg:col-span-2">
      <h2 class="text-sm font-extrabold tracking-wide uppercase text-secondary mb-3">Service Areas</h2>
      <ul class="space-y-2 text-sm mb-6">
        {areas.map((a) => (
          <li>
            <a href={a.href} class="text-gray-300 hover:text-white transition-colors">
              {a.label}
            </a>
          </li>
        ))}
        <li>
          <a href="/neighborhoods/" class="text-secondary font-bold hover:underline inline-block mt-1">
            All Neighborhoods →
          </a>
        </li>
      </ul>

      <h2 class="text-sm font-extrabold tracking-wide uppercase text-secondary mb-3">Visit</h2>
      <ul class="space-y-2 text-sm">
        <li><a href="/about/" class="text-gray-300 hover:text-white">About</a></li>
        <li><a href="/blog/" class="text-gray-300 hover:text-white">Blog & Guides</a></li>
        <li><a href="/faq/" class="text-gray-300 hover:text-white">FAQ</a></li>
        <li><a href="/contact/" class="text-gray-300 hover:text-white">Contact</a></li>
        <li><a href="/privacy/" class="text-gray-400 hover:text-white">Privacy</a></li>
      </ul>
    </div>

    <!-- Map & Address -->
    <div class="sm:col-span-2 lg:col-span-3">
      <h2 class="text-sm font-extrabold tracking-wide uppercase text-secondary mb-4">Vero Beach Hub</h2>
      <address class="not-italic text-sm space-y-1 mb-4 text-gray-300">
        <p class="font-bold text-white">{site.street}</p>
        <p>{site.city}</p>
        <p class="text-xs text-gray-400 mt-1">{site.zips.join(" · ")}</p>
      </address>

      <div class="rounded-xl overflow-hidden h-44 ring-1 ring-white/10 shadow-inner">
        <iframe
          title="Map of 4038 43rd Ave, Vero Beach"
          class="w-full h-full border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          src="https://maps.google.com/maps?q=4038%2043rd%20Ave%2C%20Vero%20Beach%2C%20FL%2032960&z=15&output=embed"
        ></iframe>
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 py-5 flex flex-col gap-2 text-xs text-gray-500">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
        <p>&copy; {year} Copperlane Water Heater Specialists. All rights reserved.</p>
        <p>Vero Beach, Florida</p>
      </div>
      <p class="text-[11px] leading-relaxed text-gray-500/90 max-w-3xl">
        This website is a referral service that connects callers with independent local water heater service providers in the Vero Beach area.
      </p>
    </div>
  </div>
</footer>

<!-- Desktop-only floating call trigger (mobile uses sticky bottom bar) -->
<a
  href={site.phoneTel}
  class="hidden lg:flex fixed bottom-4 right-4 z-50 bg-primary hover:bg-primary-dark text-white font-extrabold py-3.5 px-5 rounded-full shadow-2xl items-center gap-2 transition-transform hover:scale-105"
>
  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
  Leaking? Call now
</a>
